{
  "name": "helm-scaffold-skill",
  "version": "0.1.0",
  "description": "Install the helm-scaffold Claude Code skill — AI-guided Helm chart scaffolding and lifecycle management for EKS.",
  "bin": {
    "helm-scaffold-skill": "bin/install.js"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "SKILL.md",
    "REFERENCE.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --outfile=dist/cli.bundle.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "skill",
    "helm",
    "kubernetes",
    "eks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
